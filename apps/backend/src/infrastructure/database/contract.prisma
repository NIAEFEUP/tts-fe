// use prisma-8

// TTS Backend — database contract
//
// Design rule: one row per real-world thing, no duplicated strings, no flags
// that can disagree with each other. Every legacy polymorphic branch
// (getExchangeType, is_course_expiration, accepted+canceled booleans) is
// replaced by a single enum column.
//
// VERIFY BEFORE MIGRATING: legacy declares CourseUnit PK as `id` but also
// unique_together (id, course, year, semester) — Sigarra may reuse one
// occurrence id across academic years. Run:
//   SELECT id, COUNT(DISTINCT year) FROM course_unit GROUP BY id HAVING COUNT(*) > 1;
// If that returns rows, switch CourseUnit to a composite key (see note there).
//
// Same check for Course (legacy unique_together was (id, faculty, year)):
//   SELECT id, COUNT(DISTINCT year) FROM course GROUP BY id HAVING COUNT(*) > 1;
// If that returns rows, `id` is not stable across academic years and Course
// needs a composite key too.

// ===========================================================================
// 1. IDENTITY
// ===========================================================================

model User {
  id    String @id // NMEC, e.g. "202301234"
  // Nullable + unique: OIDC always provides it for real accounts, but a
  // student referenced in a direct exchange may never have logged in. The
  // exchange flow must still be able to create their shadow row (Postgres
  // treats NULLs as distinct in unique indexes).
  email String? @unique
  name  String

  // Global admin = may open the admin panel at all.
  // Scoped access (what they may actually act on) lives in AdminCourse/AdminCourseUnit.
  isAdmin Boolean @default(false)

  createdAt DateTime @default(now())

  enrollments        Enrollment[]
  exchangesCreated   ExchangeRequest[]   @relation("ExchangeCreator")
  exchangesTargeted  ExchangeRequest[]   @relation("ExchangeTarget")
  exchangeItems      ExchangeItem[]
  enrollmentRequests EnrollmentRequest[]
  sessions           Session[]
  adminCourses       AdminCourse[]
  adminCourseUnits   AdminCourseUnit[]
  courseMetadata     StudentCourseMetadata[]
}

// Opaque random token in an httpOnly cookie. Chosen over JWT so sessions are
// revocable and CSRF protection already exists on the frontend.
model Session {
  // sha256 of the cookie token. The raw token is never persisted: a DB leak
  // (backup, replica, logs) must not yield usable session cookies. Lookup
  // hashes the cookie value; tokens are high-entropy so a fast hash suffices.
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

// ===========================================================================
// 2. UNIVERSITY CATALOG — mirrored from Sigarra by a sync job
// ===========================================================================

model Faculty {
  acronym String   @id // "FEUP"
  name    String?
  courses Course[]
}

model Course {
  id         Int      @id // Sigarra course id (already per academic year)
  facultyId  String
  faculty    Faculty  @relation(fields: [facultyId], references: [acronym])
  acronym    String // "L.EIC"
  name       String
  courseType String // "L" | "M" | "P"
  year       Int // academic year, e.g. 2025
  // Sigarra course page URL. No current FE component reads it (the Major type
  // declares it), kept for the rewrite — linking a course page from the
  // picker is a likely use. plan_url is gone: zero consumers.
  url        String

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  units       CourseUnit[]
  admins      AdminCourse[]
}

// Legacy CourseMetadata (ects, keyed by course+unit+year) and both course-group
// tables are gone: `ects` lives on CourseUnit, and no route consumed groups.
model CourseUnit {
  id       Int    @id // Sigarra occurrence id
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  acronym  String // "BD"
  name     String
  semester Int // 1 | 2
  year     Int // curricular year, 1-5
  ects     Float
  url      String
  // Backs GET /course_unit/hash?ids=... — lets the planner detect timetable
  // changes without re-fetching every course unit.
  hash String @default("")

  createdAt DateTime @default(now())

  classes        Class[]
  exchangeItems  ExchangeItem[]
  periods        ExchangePeriod[]
  enrollments    EnrollmentRequestOption[]
  admins         AdminCourseUnit[]

  // NOTE: if the header VERIFY query finds `id` reused across years, this
  // model needs a composite key — the PK alone will collide on sync insert.
  @@index([courseId])
  @@index([courseId, semester, year])
}

model Class {
  id           Int @id @default(autoincrement()) // Sigarra has no class id
  courseUnitId Int
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id], onDelete: Cascade)

  name      String // "1LEIC01"
  vacancies Int?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  slotClasses       SlotClass[]
  enrollments       Enrollment[]
  exchangeItemsFrom ExchangeItem[] @relation("ExchangeItemFromClass")
  exchangeItemsTo   ExchangeItem[] @relation("ExchangeItemToClass")

  @@unique([name, courseUnitId])
  // FK target for ExchangeItem.fromClass/toClass composite FKs: guarantees a
  // referenced class belongs to the same course unit as the exchange item.
  @@unique([id, courseUnitId])
  @@index([courseUnitId])
}

model Professor {
  id      Int     @id // Sigarra professor code
  acronym String?
  // Nullable: Sigarra person entries can lack a name (legacy column was
  // nullable too) — the sync adapter must not fail on them.
  name    String?

  slots SlotProfessor[]
}

// One row per Sigarra lesson (its `id` is the Sigarra lesson id). A lesson can
// serve MANY classes — a shared "T" lecture for 1LEIC01..10 is the norm at
// FEUP, not an edge case (legacy marked these `is_composed`, and the sync
// writes one slot plus one slot_class row per class). The class link
// therefore lives in SlotClass, not here: folding it into a single classId
// would make a shared lesson unrepresentable.
model ScheduleSlot {
  id Int @id

  lessonType String // "T" | "TP" | "P" | "PL" | "OT" | "O" | "E"
  // 0 = Sunday. The sigarra `dia` -> 0-based conversion belongs in the
  // Sigarra adapter, never in a query.
  dayOfWeek Int
  // Minutes since midnight. Legacy used decimal(3,1) hours, which made
  // exchange_overlap() compare floats; integers remove that entirely.
  startMinute Int
  durationMin Int
  location    String?

  slotClasses SlotClass[]
  professors  SlotProfessor[]
}

// Explicit join: one lesson may appear in many class schedules and one class
// has many lessons. Kept as its own table (legacy `slot_class`) because the
// many-to-many is real.
model SlotClass {
  slotId  Int
  slot    ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  classId Int
  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([slotId, classId])
  @@index([classId])
}

// Prisma 8 has no implicit m2m.
model SlotProfessor {
  slotId      Int
  professorId Int
  slot        ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  professor   Professor    @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@id([slotId, professorId])
  @@index([professorId])
}

// ===========================================================================
// 3. STUDENT STATE
// ===========================================================================

// Local mirror of the student's current class assignments. This is what makes
// exchange validation possible without a Sigarra round-trip per check.
// A student legitimately holds several rows for one course unit (T + TP).
model Enrollment {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId Int
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  // Natural key — one enrollment per (user, class); no surrogate id.
  @@id([userId, classId])
  @@index([classId])
}

// ===========================================================================
// 4. PLATFORM CONFIGURATION
// ===========================================================================

// Deliberately course-unit-scoped only.
//
// Opening a whole course is a server-side fan-out: resolve the course's units,
// overlap-check them all, then createMany inside one transaction. Reading
// "is this course open" aggregates with DISTINCT over its units.
//
// The legacy `is_course_expiration` flag is gone: it made the same physical row
// visible through one endpoint and invisible through the other, depending on
// the flag it was created with.
model ExchangePeriod {
  courseUnitId Int
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime   @default(now())

  // Natural key — a unit is open exactly once per window.
  @@id([courseUnitId, startsAt, endsAt])
}

model AdminCourse {
  userId   String
  courseId Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([courseId])
}

model AdminCourseUnit {
  userId       String
  courseUnitId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id], onDelete: Cascade)

  @@id([userId, courseUnitId])
  @@index([courseUnitId])
}

// ===========================================================================
// 5. EXCHANGES
// ===========================================================================

enum ExchangeType {
  DIRECT // two named students swap
  MARKETPLACE // open offer anyone can claim
  URGENT // one student asks, admin approves
}

// Student-side lifecycle. Admin decisions live in adminState — legacy kept
// `accepted`/`canceled` booleans and an `admin_state` string side by side,
// which allowed nonsense states like rejected-but-not-cancelled.
//
// PENDING -> ACCEPTED  all participants accepted, or the offer was claimed,
//                    or (URGENT) the admin approved
// PENDING -> CANCELLED creator withdrew, or a conflicting exchange killed it
enum ExchangeStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

// The four real legacy values, previously free text:
// "untreated" | "treated" | "rejected" | "awaiting-information"
enum AdminValidationState {
  UNTREATED
  TREATED
  REJECTED
  AWAITING_INFORMATION
}

// Replaces DirectExchange + MarketplaceExchange + ExchangeUrgentRequests.
// `type` replaces the legacy getExchangeType() type sniffing.
model ExchangeRequest {
  id        String   @id @default(uuid())
  creatorId String
  creator   User     @relation("ExchangeCreator", fields: [creatorId], references: [id])
  // Set when the offer is claimed by a specific student (MARKETPLACE), or when
  // an admin assigns an URGENT request. Null while open.
  targetUserId String?
  targetUser   User?    @relation("ExchangeTarget", fields: [targetUserId], references: [id])

  type   ExchangeType
  status ExchangeStatus @default(PENDING)

  // Justification for URGENT requests (max 2048 in legacy).
  message String?

  adminState AdminValidationState @default(UNTREATED)

  // Backs GET /exchange/verify/{token} (email confirmation links) and the
  // duplicate-request check on creation.
  hash String?

  // Drives GET /exchange/direct/validate/{id} -> { valid, lastValidated }.
  lastValidated DateTime?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  items ExchangeItem[]

  @@index([type, status])
  @@index([adminState, createdAt])
  @@index([hash])
  @@index([creatorId, status])
  @@index([targetUserId])
}

// Replaces DirectExchangeParticipants + MarketplaceExchangeClass +
// ExchangeUrgentRequestOptions. Two of these collapse into one table because
// the only real difference was the name of the class-name column.
//
// The critical field is userId: legacy stored TWO rows per swap — one per
// student — because each side has its own from/to and its own accept flag.
// A single row without userId cannot express a 2-way exchange at all.
model ExchangeItem {
  requestId String
  request   ExchangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // Whose move this is. Legacy duplicated participant_name/course_unit_acronym
  // as strings here; both are now joins.
  // Restrict, not Cascade: silently removing one side's row would flip
  // "accepted = every item accepted" to true with a side missing. User
  // deletion must explicitly cancel affected requests instead.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  courseUnitId Int
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id])
  fromClassId  Int
  toClassId    Int
  // Composite FKs: (fromClassId, courseUnitId) and (toClassId, courseUnitId)
  // both reference Class(id, courseUnitId), so a referenced class is
  // guaranteed to belong to THIS item's course unit — not merely to exist.
  fromClass Class @relation("ExchangeItemFromClass", fields: [fromClassId, courseUnitId], references: [id, courseUnitId])
  toClass   Class @relation("ExchangeItemToClass", fields: [toClassId, courseUnitId], references: [id, courseUnitId])

  // Per-participant accept. A direct exchange is accepted when every row is
  // accepted — derived, not stored, which is what legacy's
  // DirectExchangePendingMotive() reverse-engineered at read time.
  accepted Boolean @default(false)

  // Natural key — one row per participant's move per course unit per request.
  @@id([requestId, userId, courseUnitId])
  @@index([courseUnitId])
  @@index([userId, accepted])
}

// ===========================================================================
// 6. ENROLLMENT REQUESTS
// ===========================================================================

// Replaces CourseUnitEnrollments.
model EnrollmentRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  // Deliberate reuse of ExchangeStatus: the lifecycle is the same three
  // states (legacy had only `accepted` + admin_state; CANCELLED is reserved
  // for a creator-withdraw flow the rewrite may add).
  status    ExchangeStatus @default(PENDING)
  adminState AdminValidationState @default(UNTREATED)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  options EnrollmentRequestOption[]
}

// Replaces CourseUnitEnrollmentOptions. `enrolling: false` means "drop this
// course unit" rather than "add it".
//
// No classUserGoesTo column: the POST body only ever sent
// { course_unit_id, enrolling }, and the serializer never returned a class
// either. The frontend type declares the field but nothing ever populated it.
model EnrollmentRequestOption {
  requestId String
  request   EnrollmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  courseUnitId Int
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id])
  // The owning course is reached via courseUnit.course. Legacy denormalized
  // course_unit_name / course_unit_acronym onto every option row; the frontend
  // wants option.course too, and a join answers both.

  enrolling Boolean @default(true)

  // Natural key — one option per course unit per request.
  @@id([requestId, courseUnitId])
  @@index([courseUnitId])
}

// ===========================================================================
// 7. SUPPORT
// ===========================================================================

// fest_id per (student, course), scraped from the Sigarra profile.
// Backs GET /student/{nmec}/{course_id}/metadata. Pure cache — safe to drop
// and re-populate.
model StudentCourseMetadata {
  nmec     String
  courseId Int
  festId   Int
  user     User   @relation(fields: [nmec], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([nmec, courseId])
}