# Environment schema for the TTS backend (https://varlock.dev).
# Local values go in a git-ignored `.env` (or `.env.local`); this file is committed and
# must never contain real credentials.
#
# @defaultRequired=infer
# @defaultSensitive=true
# ---

# Port the Elysia server listens on
# @public
# @type=port
PORT=3000

# PostgreSQL connection string (requires PostgreSQL >= 15)
# @required @sensitive
# @type=url(prependHttps=false)
# @example="postgres://user:password@localhost:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://tts:tts@localhost:5434"
