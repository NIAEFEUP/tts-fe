{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Generated by Prisma: declaration emit (required by `composite`) can't name its
    // inferred types (TS2742), so this is a standalone `noEmit` check, not a project reference.
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "incremental": true,
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "module": "preserve",
    "verbatimModuleSyntax": true,
    "strict": true,
    "outDir": "out-tsc/migrations",
    "rootDir": "migrations",
    "tsBuildInfoFile": "out-tsc/migrations/tsconfig.migrations.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["migrations", "migrations/**/*.json"]
}
